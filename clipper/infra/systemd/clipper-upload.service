# One upload pass: uploads one approved clip to YouTube if a slot is due (clipper/publisher/upload.py).
# Quota/errors alert on Telegram and are recorded in clips.last_error.
[Unit]
Description=Clipper YouTube upload pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/clipper/repo/clipper/publisher
EnvironmentFile=/opt/clipper/.env
Environment=PATH=/opt/clipper/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=CLIPPER_DB=/opt/clipper/db/clip.db
Environment=YOUTUBE_CLIENT_SECRET=/opt/clipper/client_secret.json
Environment=YOUTUBE_TOKEN_FILE=/opt/clipper/youtube_token.json
ExecStart=/opt/clipper/venv/bin/python upload.py
TimeoutStartSec=20min
