# Telegram approval bot (long polling), always on. Sends qc_passed clips, records approve/kill/edit.
[Unit]
Description=Clipper Telegram approval bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/clipper/repo/clipper/publisher
EnvironmentFile=/opt/clipper/.env
Environment=CLIPPER_DB=/opt/clipper/db/clip.db
ExecStart=/opt/clipper/venv/bin/python approve_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
