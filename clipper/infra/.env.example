# Copy to /opt/clipper/.env (chmod 600). Never commit the real file.
# Names only: fill values on the VM. Unset = default / feature off.
# systemd EnvironmentFile has NO inline comments: "KEY=value  # note" makes the note part of the value.
# Keep comments on their own line, no quotes needed.

# --- Anthropic (Lucas's own account only) ---
# per-clip Writer (Haiku) and daily Analyst (Sonnet)
ANTHROPIC_API_KEY=
# optional: override the Anthropic model id
CLAUDE_MODEL=
# optional: anthropic (default) or gemini
LLM_PROVIDER=
# only if LLM_PROVIDER=gemini
GEMINI_API_KEY=
# optional: Gemini model override
GEMINI_MODEL=

# --- Twitch (radar) ---
# Twitch app client id
TWITCH_CLIENT_ID=
# Twitch app client secret
TWITCH_CLIENT_SECRET=

# --- YouTube ---
# Data API key for trend scouting (read-only)
YOUTUBE_API_KEY=
# path to OAuth client_secret.json (default /opt/clipper/client_secret.json)
YOUTUBE_CLIENT_SECRET=
# path to saved upload token (default /opt/clipper/youtube_token.json)
YOUTUBE_TOKEN_FILE=
# channel label stored with uploads (default youtube-main)
YOUTUBE_CHANNEL_HANDLE=
# upload category (default 20 = Gaming)
YOUTUBE_CATEGORY_ID=

# --- Telegram approval bot + alerts ---
# bot token from BotFather
TELEGRAM_BOT_TOKEN=
# the only chat the bot answers to
TELEGRAM_ALLOWED_CHAT_ID=

# --- Auto-post (publisher/approve_bot.py) ---
# 1 = clips post without a tap; Telegram gets an FYI with a Stop button (works until the upload slot)
AUTO_POST=
# 1 = also auto-post clips flagged music_risk (default: those still wait for a tap)
AUTO_POST_MUSIC=

# --- Upload schedule (publisher/upload.py) ---
# timezone of the upload window
UPLOAD_TZ=
# window start, HH:MM
UPLOAD_WINDOW_START=
# window end, HH:MM
UPLOAD_WINDOW_END=
# max uploads per day
UPLOAD_MAX_PER_DAY=
# min hours between uploads
UPLOAD_MIN_GAP_HOURS=
# public (default), unlisted or private
UPLOAD_PRIVACY=

# --- Paths and tuning (systemd units already set CLIPPER_DB) ---
# SQLite file (default /opt/clipper/db/clip.db)
CLIPPER_DB=
# rendered clips dir (default /opt/clipper/clips)
CLIPPER_CLIPS=
# scratch/download dir (default /opt/clipper/work)
CLIPPER_WORK=
# pipeline flock file (default /opt/clipper/pipeline.lock)
CLIPPER_LOCK=
# optional: path to saturation data for radar heat
CLIPPER_SATURATION=
# fonts dir for captions (default /opt/clipper/fonts; setup.sh downloads Montserrat)
CLIPPER_FONTS=
# YuNet face model for the 9:16 layout (default /opt/clipper/models/face_detection_yunet_2023mar.onnx)
CLIPPER_FACE_MODEL=
# daily market caption style (style scout) the renderer follows (default /opt/clipper/formats/style.json)
CLIPPER_STYLE=
# Trend Scout format library copy the Writer follows (default /opt/clipper/formats/library.md)
CLIPPER_FORMATS=
# market hashtags (hashtag scout) the uploader adds (default /opt/clipper/formats/hashtags.json)
CLIPPER_HASHTAGS=
# daily Shorts market scan: demand + popping titles per streamer (default /opt/clipper/formats/market.json)
CLIPPER_MARKET=
# per-streamer market look from their popping Shorts (default /opt/clipper/formats/styles.json)
CLIPPER_STYLES=
# channel handle burned low-centre like the top clip channels (default @Peakz.Recaps; empty = off)
CLIPPER_WATERMARK=
# visual check of every finished Short before it can post (Claude Haiku on 3 frames); 0 = off
VISUAL_QA=
# faster-whisper model (default small; base on <4 GB RAM)
WHISPER_MODEL=
# read-only YouTube Analytics token (stay %, watch %), separate from the upload token (default /opt/clipper/youtube_analytics_token.json)
YOUTUBE_ANALYTICS_TOKEN=
# remake engine (D58): work dir for downloads + maps (default /opt/clipper/remake)
CLIPPER_REMAKE=
# remake engine lock file (default /opt/clipper/remake.lock)
CLIPPER_REMAKE_LOCK=
# fonts libass uses for remake captions (default /opt/clipper/fonts)
CLIPPER_FONTS=
# remakes registered per day at most (default 5)
REMAKES_PER_DAY=
# processes for the remake video map (default 5)
REMAKE_WORKERS=
# Model for the one caption-look call per remake (shadow, glow, box; D61). Default claude-sonnet-5-5.
REMAKE_STYLE_MODEL=
# Seconds after which a remake run starts no new Short (default 2400; systemd stops it at 75 min)
REMAKE_RUN_BUDGET_S=
# Give up on finding a Short's moment in the streams after this many seconds (default 600, #131)
REMAKE_SEARCH_BUDGET_S=
# Quality gate: a remake below either match % vs the original is skipped (defaults 80 and 70)
REMAKE_MIN_PICTURE=
REMAKE_MIN_CAPTIONS=
# D62: caption word colours are ours (multicolour), the caption gate ignores colour; 0 = their colours
REMAKE_OUR_COLOURS=
# yt-dlp binary the remake engine calls (default yt-dlp on PATH)
YTDLP=
# Lucas's YouTube cookies (Netscape cookies.txt) for clipper Short downloads, D59 (default /opt/clipper/youtube_cookies.txt; chmod 600)
YTDLP_COOKIES=
# our own cuts of Twitch clips (radar -> capture -> Writer -> render); off since D60, remakes only. 1 = on
CLIPPER_OWN_CUTS=
# remakes post without a tap (default off: Lucas checks each one next to the original). 1 = on
AUTO_POST_REMAKES=
