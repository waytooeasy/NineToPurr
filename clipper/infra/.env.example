# Copy to /opt/clipper/.env (chmod 600). Never commit the real file.
# Names only: fill values on the VM. Unset = default / feature off.
# systemd EnvironmentFile has NO inline comments: "KEY=value  # note" makes the note part of the value.
# Keep comments on their own line, no quotes needed.

# --- Anthropic (Lucas's own account only) ---
# per-clip Writer (Haiku) and daily Analyst (Sonnet)
ANTHROPIC_API_KEY=
# optional: override the Anthropic model id
CLAUDE_MODEL=
# optional: anthropic (default) or gemini
LLM_PROVIDER=
# only if LLM_PROVIDER=gemini
GEMINI_API_KEY=
# optional: Gemini model override
GEMINI_MODEL=

# --- Twitch (radar) ---
# Twitch app client id
TWITCH_CLIENT_ID=
# Twitch app client secret
TWITCH_CLIENT_SECRET=

# --- YouTube ---
# Data API key for trend scouting (read-only)
YOUTUBE_API_KEY=
# path to OAuth client_secret.json (default /opt/clipper/client_secret.json)
YOUTUBE_CLIENT_SECRET=
# path to saved upload token (default /opt/clipper/youtube_token.json)
YOUTUBE_TOKEN_FILE=
# channel label stored with uploads (default youtube-main)
YOUTUBE_CHANNEL_HANDLE=
# upload category (default 20 = Gaming)
YOUTUBE_CATEGORY_ID=

# --- Telegram approval bot + alerts ---
# bot token from BotFather
TELEGRAM_BOT_TOKEN=
# the only chat the bot answers to
TELEGRAM_ALLOWED_CHAT_ID=

# --- Upload schedule (publisher/upload.py) ---
# timezone of the upload window
UPLOAD_TZ=
# window start, HH:MM
UPLOAD_WINDOW_START=
# window end, HH:MM
UPLOAD_WINDOW_END=
# max uploads per day
UPLOAD_MAX_PER_DAY=
# min hours between uploads
UPLOAD_MIN_GAP_HOURS=
# public (default), unlisted or private
UPLOAD_PRIVACY=

# --- Paths and tuning (systemd units already set CLIPPER_DB) ---
# SQLite file (default /opt/clipper/db/clip.db)
CLIPPER_DB=
# rendered clips dir (default /opt/clipper/clips)
CLIPPER_CLIPS=
# scratch/download dir (default /opt/clipper/work)
CLIPPER_WORK=
# pipeline flock file (default /opt/clipper/pipeline.lock)
CLIPPER_LOCK=
# optional: path to saturation data for radar heat
CLIPPER_SATURATION=
# fonts dir for captions (default /opt/clipper/fonts; setup.sh downloads Montserrat)
CLIPPER_FONTS=
# Trend Scout format library copy the Writer follows (default /opt/clipper/formats/library.md)
CLIPPER_FORMATS=
# faster-whisper model (default small; base on <4 GB RAM)
WHISPER_MODEL=
