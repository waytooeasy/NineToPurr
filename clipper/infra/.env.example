# Copy to /opt/clipper/.env (chmod 600). Never commit the real file.
# Names only: fill values on the VM. Unset = default / feature off.

# --- Anthropic (Lucas's own account only) ---
ANTHROPIC_API_KEY=        # per-clip Writer (Haiku) and daily Analyst (Sonnet)
CLAUDE_MODEL=             # optional: override the Anthropic model id
LLM_PROVIDER=             # optional: anthropic (default) or gemini
GEMINI_API_KEY=           # only if LLM_PROVIDER=gemini
GEMINI_MODEL=             # optional: Gemini model override

# --- Twitch (radar) ---
TWITCH_CLIENT_ID=         # Twitch app client id
TWITCH_CLIENT_SECRET=     # Twitch app client secret

# --- YouTube ---
YOUTUBE_API_KEY=          # Data API key for trend scouting (read-only)
YOUTUBE_CLIENT_SECRET=    # path to OAuth client_secret.json (default /opt/clipper/client_secret.json)
YOUTUBE_TOKEN_FILE=       # path to saved upload token (default /opt/clipper/youtube_token.json)
YOUTUBE_CHANNEL_HANDLE=   # channel label stored with uploads (default youtube-main)
YOUTUBE_CATEGORY_ID=      # upload category (default 20 = Gaming)

# --- Telegram approval bot + alerts ---
TELEGRAM_BOT_TOKEN=       # bot token from BotFather
TELEGRAM_ALLOWED_CHAT_ID= # the only chat the bot answers to

# --- Upload schedule (publisher/upload.py) ---
UPLOAD_TZ=                # timezone of the upload window
UPLOAD_WINDOW_START=      # window start, HH:MM
UPLOAD_WINDOW_END=        # window end, HH:MM
UPLOAD_MAX_PER_DAY=       # max uploads per day
UPLOAD_MIN_GAP_HOURS=     # min hours between uploads
UPLOAD_PRIVACY=           # public (default), unlisted or private

# --- Paths and tuning (systemd units already set CLIPPER_DB) ---
CLIPPER_DB=               # SQLite file (default /opt/clipper/db/clip.db)
CLIPPER_CLIPS=            # rendered clips dir (default /opt/clipper/clips)
CLIPPER_WORK=             # scratch/download dir (default /opt/clipper/work)
CLIPPER_LOCK=             # pipeline flock file (default /opt/clipper/pipeline.lock)
CLIPPER_SATURATION=       # optional: path to saturation data for radar heat
WHISPER_MODEL=            # faster-whisper model (default small; base on <4 GB RAM)
